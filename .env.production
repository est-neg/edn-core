# Production Cloud Run environment variables.
# Secrets are injected separately via Secret Manager during deploy.

VIL_HTTP_ADDR=:8080
VIL_HTTP_READ_TIMEOUT_SEC=10
VIL_HTTP_WRITE_TIMEOUT_SEC=30
VIL_HTTP_IDLE_TIMEOUT_SEC=120

VIL_LOG_LEVEL=info
VIL_LOG_JSON=true

VIL_MONGODB_DATABASE=edn-core-db-prd
VIL_MONGODB_CONNECT_TIMEOUT_SEC=10
VIL_MONGODB_COLLECTION_LEADS=leads

VIL_MONGODB_COLLECTION_PLANS=plans
VIL_MONGODB_COLLECTION_ORDERS=orders
VIL_MONGODB_COLLECTION_PAYMENTS=payments
VIL_MONGODB_COLLECTION_SUBSCRIPTIONS=subscriptions
VIL_MONGODB_COLLECTION_WEBHOOK_EVENTS=webhook_events
VIL_MONGODB_COLLECTION_OUTBOX_EVENTS=outbox_events

# VIL_REDIS_PASSWORD — injected via Secret Manager
VIL_REDIS_ADDR=redis-14298.crce214.us-east-1-3.ec2.cloud.redislabs.com:14298
VIL_REDIS_DB=0
VIL_REDIS_DIAL_TIMEOUT_SEC=5
VIL_REDIS_READ_TIMEOUT_SEC=3
VIL_REDIS_WRITE_TIMEOUT_SEC=3
VIL_REDIS_POOL_SIZE=20

# VIL_PAYMENTS_WEBHOOK_SECRET_PATH — injected via Secret Manager
# VIL_PAYMENTS_INTERNAL_VERIFY_AUTH_TOKEN — injected via Secret Manager
# VIL_PAYMENTS_INFINITEPAY_API_TOKEN — injected via Secret Manager
# VIL_PAYMENTS_WEBHOOK_URL — injected via Secret Manager
VIL_PAYMENTS_REDIRECT_URL=https://edn-core.app/checkout/return
VIL_PAYMENTS_REQUEST_BODY_MAX_BYTES=65536
VIL_PAYMENTS_OUTBOX_DISPATCH_INTERVAL_SEC=15
VIL_PAYMENTS_INFINITEPAY_BASE_URL=https://api.infinitepay.io

VIL_PUBSUB_PROJECT_ID=funcionario-online-493412
VIL_PUBSUB_PAYMENT_APPROVED_TOPIC=payment-approved-prd
VIL_PUBSUB_PAYMENT_APPROVED_SUBSCRIPTION=payment-approved-activation-sub-prd

VIL_LEADS_AUTH_HEADER=Authorization
VIL_LEADS_MAX_BODY_BYTES=16384
VIL_LEADS_DEDUP_WINDOW_SEC=300
VIL_LEADS_RATE_LIMIT_REQUESTS_PER_MINUTE=60
VIL_LEADS_RATE_LIMIT_WINDOW_SEC=60
VIL_LEADS_MAX_IN_FLIGHT=10
